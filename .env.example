# songbird configuration — copy to .env and edit. (.env is gitignored.)

# The port songbird is reachable on, in Docker and outside it.
PORT=8077

# Where songbird keeps its OWN SQLite DB (annotations/tags/users land here in later
# slices). No Bible text ever lives here — that comes from Concord over HTTP.
DATA_DIR=./data

# Where songbird reads Scripture from. Concord may be on this machine or any other machine
# on your network, on any port — songbird calls whatever address it is given.
#
#   Local dev (uvicorn on the host, Concord on the host):  http://localhost:8000
#   songbird in Docker, Concord on the host:               http://host.docker.internal:8000
#   Concord on another LAN machine:                         http://192.168.1.62:8000
#
# This line decides which translations you get, so it is worth being deliberate about.
# Leave it out and `docker compose --profile bundled-concord up` starts a ready-made Concord
# carrying the public-domain translations — KJV, ASV, WEB, BSB and a dozen more. Licensed
# translations like the ESV or the NKJV can't be in a public download, so if you built your
# own Concord that serves them, name it here or songbird will never see them.
#
# Not sure which one songbird ended up on? The app's Status page names the address it is
# using and lists every translation it found there.
#
# Concord is a HARD dependency: if it's unreachable, songbird errors. There is no offline
# fallback and no bundled copy of the text.
CONCORD_BASE_URL=http://localhost:8000

# Session cookie `Secure` flag. Leave false for the default LAN-HTTP deploy; set to 1/true the
# moment songbird is fronted with TLS, so the session cookie is only sent over HTTPS.
# See docs/SECURITY.md for the full exposing-beyond-LAN checklist.
COOKIE_SECURE=false

# Sermon sources — songbird can follow a YouTube channel and make the sermon notes for you.
# That needs a free key for YouTube's Data API, which you create in Google's Cloud console.
# Leaving this line commented out is a perfectly good state: the feature stays switched off and
# nothing else changes. Unlike Concord, YouTube is not a hard dependency — if it is unreachable
# songbird records that and carries on.
#
# Treat the key like a password: it belongs in .env, never in a file you commit or share.
#YOUTUBE_API_KEY=

# How often songbird checks your sources for new sermons, in hours. 168 is once a week.
# Set it to 0 to turn the scheduled check off and only ever check when you ask.
SERMON_CHECK_INTERVAL_HOURS=168

# Sermons shorter than this many minutes are skipped, which keeps clips, trailers and Shorts out
# of your notes. It is the starting point for every channel you follow; a single channel can be
# given its own number on the Sermon sources page, and that one wins for that channel.
SERMON_MIN_MINUTES=10
